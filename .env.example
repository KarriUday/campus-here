# ---------------------------------------------------------------------------
# Campus Here — environment template.
# Copy to `.env` and fill in. `.env` is git-ignored; never commit real secrets.
# ---------------------------------------------------------------------------

# --- Database (PostgreSQL) -------------------------------------------------
# Pooled connection string used by the app at runtime (Neon pooler / Supabase
# transaction pooler / Vercel Postgres).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Direct (non-pooled) connection. Prisma Migrate needs this; pooled endpoints
# cannot run DDL. On Neon this is the "-pooler"-less host.
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Auth ------------------------------------------------------------------
# HS256 signing key for session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me-to-a-long-random-string"
# 32-byte key (base64url) for AES-256-GCM encryption of stored SMTP credentials.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ENCRYPTION_KEY="change-me-32-byte-base64url-key"

# --- Application -----------------------------------------------------------
# Absolute base URL, used in password-reset links and email bodies.
APP_URL="http://localhost:3000"
# IANA timezone that reminder scheduling is anchored to (09:00 local dispatch).
APP_TIMEZONE="Asia/Kolkata"

# --- Cron ------------------------------------------------------------------
# Shared secret for /api/cron/reminders. Vercel Cron sends it as a Bearer token;
# the local `npm run cron` runner uses the same value.
CRON_SECRET="change-me-to-a-long-random-string"

# --- Email (Nodemailer / SMTP) ---------------------------------------------
# With MAIL_DRY_RUN=true nothing leaves the machine: sends are logged and
# persisted with mode=DRY_RUN. Set to false only once real credentials are set.
MAIL_DRY_RUN="true"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
# Gmail App Password (16 chars, no spaces) — NOT the account password.
# Create one at https://myaccount.google.com/apppasswords
SMTP_PASS=""
SMTP_FROM="Campus Here <no-reply@example.com>"
# Total attachment budget per email, in bytes (spec §3.8 caps this at 20MB).
MAIL_MAX_ATTACHMENT_BYTES="20971520"

# --- WhatsApp (Twilio) -----------------------------------------------------
WHATSAPP_DRY_RUN="true"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# Twilio sandbox sender. Keep the `whatsapp:` prefix.
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# --- Demo ------------------------------------------------------------------
# Real inbox used by the Mail Center "send test" button. Kept out of the seed
# data because this repository is public.
DEMO_STUDENT_EMAIL=""
# Password given to every seeded account. Change before any real deployment.
SEED_PASSWORD="Campus@123"

# Password assigned to accounts created by a bulk CSV import. Students are
# expected to reset it via the forgot-password flow.
DEFAULT_IMPORT_PASSWORD="Campus@123"
